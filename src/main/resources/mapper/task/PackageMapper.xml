<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.lee.tms.modules.task.mapper.PackageMapper">
    <resultMap id="packageResult" type="com.lee.tms.modules.task.entity.Package">
        <!-- 公共字段 -->
        <result property="id" column="id"/>
        <result property="createTime" column="create_time"/>
        <result property="updateTime" column="update_time"/>
        <result property="createBy" column="create_by"/>
        <result property="updateBy" column="update_by"/>
        <!-- 普通字段 -->
        <result property="srId" column="sr_id"/>
        <result property="packageNo" column="package_no"/>
        <result property="packageType" column="package_type"/>
        <result property="teamId" column="team_id"/>
        <result property="packageQuantity" column="package_quantity"/>
        <result property="packageMh" column="package_mh"/>
        <result property="packageStartDate" column="package_start_date"/>
        <result property="packageCompletedDate" column="package_completed_date"/>
        <result property="packageWorkDays" column="package_work_days"/>
        <result property="issueDate" column="issue_date"/>
        <result property="issuerId" column="issuer_id"/>
        <result property="remark" column="remark"/>
        <result property="sn" column="sn"/>
        <result property="packageTargetDate" column="package_target_date"/>
        <result property="isIssued" column="is_issued"/>
        <result property="isDistributed" column="is_distributed"/>
        <!-- 关联对象字段 (如果表字段名以 Id 结尾) -->
        <association property="dept" javaType="com.lee.tms.modules.system.entity.Dept">
            <result property="teamName" column="dept_name"/>
        </association>
        <association property="user" javaType="com.lee.tms.modules.system.entity.User">
            <result property="issuerName" column="enployee_name"/>
        </association>
    </resultMap>
</mapper>